# Impostazioni di ReBadge. Copia questo file in .env.local (in locale) o inserisci i valori su Vercel.
# .env.local non va mai nel repository (è già escluso da .gitignore).
# Guide: SUPABASE_SETUP.md e STRIPE_SETUP.md. Per provare senza configurare nulla: npm run demo.

# --- Supabase (Project Settings → API) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO server: serve al webhook di Stripe e alla pulizia dei PDF orfani. Mai in variabili NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Indirizzo pubblico dell'app (link nelle email e ritorno da Stripe) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (prima in modalità test: chiavi sk_test_…) ---------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID dei prezzi mensili (price_…): Base fino a 5 dipendenti, Plus da 6 a 30
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=
